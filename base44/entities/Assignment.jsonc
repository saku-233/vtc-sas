{
  "type": "object",
  "properties": {
    "courseCode": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "weight": {
      "type": "number"
    },
    "due": {
      "type": "string"
    },
    "status": {
      "type": "enum",
      "enum": [
        "\u672a\u5f00\u59cb",
        "\u8fdb\u884c\u4e2d",
        "\u5df2\u63d0\u4ea4",
        "\u5df2\u8bc4\u5206"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "blue",
        "green"
      ]
    },
    "grade": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "courseCode",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Assignment"
}